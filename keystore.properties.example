# Copy this file to keystore.properties (gitignored) and fill in your upload key.
# Generate a keystore with:
#   keytool -genkeypair -v -keystore upload-keystore.jks -keyalg RSA -keysize 2048 -validity 10000 -alias upload
#
# Play Console checklist (do these in the console after :app:bundleRelease):
# - Unique applicationId (this project uses com.ebisoft.doremmi)
# - Content rating questionnaire
# - Data safety form
# - Privacy policy URL (required because the app records audio)
# - Phone and tablet landscape screenshots, feature graphic, 512px icon
# - Upload the AAB from app/build/outputs/bundle/release/

storeFile=upload-keystore.jks
storePassword=YOUR_STORE_PASSWORD
keyAlias=upload
keyPassword=YOUR_KEY_PASSWORD
