<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:theme="@style/Theme.Doremmi.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".LessonListActivity"
            android:exported="false"
            android:label="@string/section_lessons"
            android:parentActivityName=".HomeActivity" />

        <activity
            android:name=".LessonActivity"
            android:exported="false"
            android:parentActivityName=".LessonListActivity"
            android:screenOrientation="sensorLandscape"
            tools:ignore="DiscouragedApi" />

        <activity
            android:name=".FreeStyleActivity"
            android:exported="false"
            android:label="@string/section_free_play"
            android:parentActivityName=".HomeActivity"
            android:screenOrientation="sensorLandscape"
            tools:ignore="DiscouragedApi" />

        <activity
            android:name=".SongsActivity"
            android:exported="false"
            android:label="@string/section_songs"
            android:parentActivityName=".HomeActivity" />

        <activity
            android:name=".GamesActivity"
            android:exported="false"
            android:label="@string/section_games"
            android:parentActivityName=".HomeActivity" />

        <activity
            android:name=".QuizActivity"
            android:exported="false"
            android:parentActivityName=".GamesActivity" />

        <activity
            android:name=".ScoresActivity"
            android:exported="false"
            android:label="@string/section_scores"
            android:parentActivityName=".HomeActivity" />
    </application>

</manifest>
