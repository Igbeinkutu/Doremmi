<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/space_s"
    android:paddingTop="@dimen/space_m"
    android:paddingBottom="@dimen/space_s">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:accessibilityHeading="true"
        android:text="@string/app_name"
        android:textAppearance="@style/TextAppearance.Doremmi.Display"
        android:textColor="?attr/colorPrimary" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/home_greeting"
        android:textAppearance="@style/TextAppearance.Doremmi.Body"
        android:textColor="?attr/colorOnSurfaceVariant" />
</LinearLayout>
