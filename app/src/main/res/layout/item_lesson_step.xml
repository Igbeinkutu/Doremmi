<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/space_s">

    <TextView
        android:id="@+id/step_text"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center"
        android:maxWidth="@dimen/content_max_width"
        android:textAppearance="@style/TextAppearance.Doremmi.LessonStep"
        app:autoSizeMaxTextSize="@dimen/lesson_text_max"
        app:autoSizeMinTextSize="@dimen/lesson_text_min"
        app:autoSizeStepGranularity="1sp"
        app:autoSizeTextType="uniform"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="@dimen/content_max_width" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/step_media"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="?attr/colorSurfaceContainerLowest"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="@dimen/content_max_width">

        <ImageView
            android:id="@+id/step_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:importantForAccessibility="no"
            android:padding="@dimen/space_s"
            android:scaleType="fitCenter" />

        <com.ebisoft.doremmi.notation.NotationView
            android:id="@+id/step_notation"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:padding="@dimen/space_m" />

        <ImageView
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:layout_gravity="top|end"
            android:importantForAccessibility="no"
            android:padding="12dp"
            android:src="@drawable/ic_open_in_full"
            app:tint="?attr/colorOnSurfaceVariant" />
    </com.google.android.material.card.MaterialCardView>
</androidx.constraintlayout.widget.ConstraintLayout>
