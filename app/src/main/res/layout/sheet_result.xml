<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_l"
        android:paddingTop="@dimen/space_s"
        android:paddingBottom="@dimen/space_l">

        <ImageView
            android:id="@+id/result_icon"
            android:layout_width="@dimen/result_icon"
            android:layout_height="@dimen/result_icon"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/result_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Doremmi.Headline"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/result_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Doremmi.Display"
            android:textColor="?attr/colorPrimary"
            android:visibility="gone" />

        <TextView
            android:id="@+id/result_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:gravity="center"
            android:maxWidth="480dp"
            android:textAppearance="@style/TextAppearance.Doremmi.Body"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/result_highlight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:background="@drawable/bg_pill"
            android:paddingHorizontal="@dimen/space_m"
            android:paddingVertical="@dimen/space_xs"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="?attr/colorOnSecondaryContainer"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/result_primary"
            style="@style/Widget.Doremmi.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:maxWidth="480dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/result_secondary"
            style="@style/Widget.Doremmi.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:maxWidth="480dp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/result_tertiary"
            style="@style/Widget.Doremmi.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:visibility="gone" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
