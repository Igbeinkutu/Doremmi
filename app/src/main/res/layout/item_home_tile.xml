<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Doremmi.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/space_s">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:minHeight="@dimen/tile_min_height"
        android:orientation="vertical"
        android:padding="@dimen/space_m">

        <FrameLayout
            android:layout_width="@dimen/tile_icon_container"
            android:layout_height="@dimen/tile_icon_container"
            android:background="@drawable/bg_icon_circle">

            <ImageView
                android:id="@+id/tile_icon"
                android:layout_width="@dimen/tile_icon"
                android:layout_height="@dimen/tile_icon"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                app:tint="?attr/colorOnSecondaryContainer"
                tools:src="@drawable/ic_piano" />
        </FrameLayout>

        <TextView
            android:id="@+id/tile_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Doremmi.Title"
            android:textColor="?attr/colorOnSurface"
            tools:text="Free Play" />

        <TextView
            android:id="@+id/tile_description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Doremmi.Caption"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="Play and record" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
